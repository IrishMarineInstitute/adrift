from opendrift.models.leeway import Leeway
from opendrift.readers import reader_global_landmask
from opendrift.readers import reader_netCDF_CF_generic
from opendrift.readers import reader_ROMS_native
from datetime import datetime, timedelta, timezone
import pytz

landmask = reader_global_landmask.Reader()

def string2utc(string):
    ''' Convert datetime string to UTC '''

    # Convert string to datetime object
    dt = datetime.fromisoformat(string)

    # Convert to datetime-aware    
    dt = pytz.timezone("Europe/Dublin").localize(dt)
    
    # Convert to UTC
    utc = dt.astimezone(timezone.utc)
    
    y, m, d, H, M = utc.year, utc.month, utc.day, utc.hour, utc.minute
    
    return datetime(y, m , d, H, M)

filename = '{{nc_output_path}}'

""" Set seeding conditions """
longitude = {{longitude}}
latitude = {{latitude}}
    
# Set number of floats 
N = {{number_of_particles}}

# Date
itime = string2utc("{{idate}}")
etime = string2utc("{{edate}}")
    
# Radius for uniform dispersion around source [meters]
R = {{radius}}

# End time of simulation
end_time = string2utc("{{end_of_run}}")
    
""" Model initialization """
model = Leeway(loglevel=20); model.set_config('general:use_auto_landmask', False)

""" Add readers """
#######################################################################
# THIS PART IS MODIFIED IN MARCH 2026 TO INCLUDE DUBLIN BAY AND TO 
# IMPROVE PERFORMANCE, BY ADDING ONLY THOSE READERS (MODELS) THAT ARE
# LIKELY TO BE NEEDED IN THE SIMULATION.

# ECMWF wind is always used in Leeway model
url = 'http://milas.marine.ie/thredds/dodsC/adrift_wind/adrift_wind_aggregate.nc'
rdr = reader_netCDF_CF_generic.Reader(url)
model.add_reader(rdr)
del url, rdr

# Connemara bounding box (with a 0.25-degree padding around model boundaries)
lon_min = -11.0485
lon_max = -8.6465
lat_min = 52.7009
lat_max = 53.9791

if (longitude > lon_min and longitude < lon_max and latitude > lat_min and latitude < lat_max):
    # Include Galway Bay
    url = 'http://milas.marine.ie/thredds/dodsC/IMI_ROMS_HYDRO/GALWAY_BAY_NATIVE_70M_8L_1H/COMBINED_AGGREGATION'
    rdr = reader_ROMS_native.Reader(url)
    model.add_reader(rdr)
    del url, rdr
    
    # Include Connemara
    url = 'http://milas.marine.ie/thredds/dodsC/IMI_ROMS_HYDRO/CONNEMARA_250M_20L_1H/COMBINED_AGGREGATION'
    rdr = reader_ROMS_native.Reader(url)
    model.add_reader(rdr)
    del url, rdr

# Dublin bounding box (with a 0.25-degree padding around model boundaries)
lon_min = -6.4984
lon_max = -5.6986
lat_min = 52.9827
lat_max = 53.6382

if (longitude > lon_min and longitude < lon_max and latitude > lat_min and latitude < lat_max):
    # Include Dublin Bay
    url = 'http://milas.marine.ie/thredds/dodsC/OPENDRIFT-AGGREGATE'
    rdr = reader_ROMS_native.Reader(url)
    model.add_reader(rdr)
    del url, rdr

# Bantry bounding box (with a 0.25-degree padding around model corners)
lon_min = -11.2398
lon_max = -8.3816
lat_min = 50.2933
lat_max = 52.2642

if (longitude > lon_min and longitude < lon_max and latitude > lat_min and latitude < lat_max):
    # Include Bantry Bay
    url = 'http://milas.marine.ie/thredds/dodsC/IMI_ROMS_HYDRO/BANTRY_BAY_NATIVE_250M_20L_1H/COMBINED_AGGREGATION'
    rdr = reader_ROMS_native.Reader(url)
    model.add_reader(rdr)
    del url, rdr

model.add_reader(landmask)

# Finally, add Ne-Atl
url = 'http://milas.marine.ie/thredds/dodsC/IMI_ROMS_HYDRO/NEATLANTIC_NATIVE_2KM_40L_1H/COMBINED_AGGREGATION'
rdr = reader_ROMS_native.Reader(url)
model.add_reader(rdr)
del url, rdr
#######################################################################

object_type = {{object_type}} # {{object_type_key}} {{object_type_description}}

model.set_config('general:coastline_action', 'previous')

""" Seed elements """
model.seed_elements(lon=longitude,
                lat=latitude,
                number=N,
                radius=R,
                radius_type="uniform",
                time=[itime, etime],
                object_type=object_type
                )

        
""" Model run """
model.run(end_time=end_time, 
        time_step=timedelta(minutes=5), 
        time_step_output=timedelta(minutes=15), 
        outfile=filename,
        export_variables=["trajectory", 
                            "time", 
                            "status", "object_type",
                            "age_seconds",
                            "lon", 
                            "lat"]
        )
